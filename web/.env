# SQLite for local/demo (Prisma bundles its engine — no server needed)
DATABASE_URL="file:./prisma/dev.db"

# Signing secret for session cookies (demo value — change in production)
AUTH_SECRET="dev-only-change-me-9f3a7c2e1b6d4a8f0e5c7b9a2d4f6e8c"

# bcrypt work factor for password hashing (OWASP floor is 12)
BCRYPT_ROUNDS="12"

# Mock external providers until real integrations are wired
MOCK_GNUSCORE="true"
MOCK_MOMO="true"
